{
  "expo": {
    "name": "Tech Rabbit Calc",
    "slug": "tech-rabbit-ai-kalkylator",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "techrabbitkalkylator",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "se.aimstudios.techrabbit.kalkylator",
      "icon": {
        "light": "./assets/ikon/ikon-ljus.png",
        "dark": "./assets/ikon/ikon-mork.png",
        "tinted": "./assets/ikon/ikon-tonad.png"
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Tech Rabbit Calc använder mikrofonen när du trycker på mikrofonknappen, så att du kan prata in din fråga i stället för att skriva den.",
        "NSSpeechRecognitionUsageDescription": "Talet görs om till text så att frågan hamnar i fältet. Inget ljud sparas och inget ljud lämnar telefonen.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.aimstudios.techrabbit.kalkylator",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ikon/ikon-android-forgrund.png",
        "monochromeImage": "./assets/ikon/ikon-android-monokrom.png",
        "backgroundColor": "#010101"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F2",
          "dark": {
            "backgroundColor": "#0B0B0B"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tech Rabbit Calc använder mikrofonen när du trycker på mikrofonknappen, så att du kan prata in din fråga i stället för att skriva den.",
          "speechRecognitionPermission": "Talet görs om till text så att frågan hamnar i fältet. Inget ljud sparas och inget ljud lämnar telefonen.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/ikon/ikon-ljus.png",
    "extra": {
      "router": {
        "asyncRoutes": {

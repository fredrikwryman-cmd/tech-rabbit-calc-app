{
  "name": "@techrabbit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tester.json",
    "test": "node --test \"tester/**/*.test.ts\""
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@techrabbit/engine": "*",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "^58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "^58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.1"
  },
  "expo": {
    "install": {
      "comment": "Expo SDK 58 vantar react 19.3.0 och react-native-worklets 0.13.0, men varje expo-paket i tradet loser till 19.3.1 respektive 0.13.1. Att pinna SDK:ns exakta patch ger tva kopior av en native-modul, vilket ar varre an en patch ifran. Haller vi en kopia pa .1 och undantar dem fran versionskontrollen.",
      "exclude": [
        "react",
        "react-native-worklets"
      ]
    }
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
